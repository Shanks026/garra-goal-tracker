# Copy to `.env` and fill in. `.env` is gitignored by the repo-root .gitignore; this example
# file is the one env file git tracks, so it must never contain a real value.
#
# EXPO_PUBLIC_* vars are inlined into the JS bundle by Metro at build time. That is correct for
# both values below — the publishable key is designed to be shipped in a client, and RLS is what
# actually protects the data. The service_role key is NOT here and must never be used in this
# app: it bypasses RLS entirely.
#
# Find these in Supabase → Project Settings → API.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
